# cp .env.example .env
#
# Nest ConfigModule loads:
#   .env.${NODE_ENV}   then   .env
# Read in code with ConfigService, e.g. config.get('app.port')

NODE_ENV=development
PORT=8000
LOG_LEVEL=debug
WEB_ORIGIN=http://localhost:3000

# Optional. Jenkins sets this to the git sha so /health and the Docker tag match.
# Local default is 0.1.0 (see src/config/app.config.ts).
APP_VERSION=0.1.0

# You (platform operator). Required for POST /api/v1/platform/tenants
PLATFORM_API_KEY=change-me-platform-key

# App role — must not be a superuser (superusers bypass RLS).
DATABASE_URL=postgresql://membership_app:multitenant@localhost:5432/multitenant_membership?schema=public
# Superuser — Prisma CLI / migrate only.
MIGRATE_DATABASE_URL=postgresql://multitenant:multitenant@localhost:5432/multitenant_membership?schema=public
REDIS_URL=redis://localhost:6379

# Staff JWT (Phase 2). Access is short-lived; refresh lives in Redis + httpOnly cookie.
JWT_SECRET=change-me-access-secret
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRE=30d
COOKIE_SECURE=false

POSTGRES_USER=multitenant
POSTGRES_PASSWORD=multitenant
POSTGRES_DB=multitenant_membership
POSTGRES_PORT=5432
REDIS_PORT=6379
