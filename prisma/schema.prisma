generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum CountryCode {
  EG
  SA
}

enum StaffRole {
  TENANT_OWNER
  ADMIN
  BRANCH_STAFF
}

/// The tenant business account.
model Tenant {
  id        String          @id @default(uuid()) @db.Uuid
  slug      String          @unique
  name      String
  country   CountryCode     @default(EG)
  timezone  String
  currency  String          @db.VarChar(3)
  status    TenantStatus    @default(ACTIVE)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  settings      TenantSettings?
  branches      Branch[]
  staff         Staff[]
  members       Member[]
  plans          Plan[]
  planBranches   PlanBranch[]
  subscriptions  Subscription[]
  freezes        SubscriptionFreeze[]
  notifications  Notification[]
  checkIns       CheckIn[]

  @@map("tenants")
}

/// Gym-wide freeze and grace policy. One freeze policy for time plans and packs.
model TenantSettings {
  tenantId             String   @id @map("tenant_id") @db.Uuid
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  graceEnabled         Boolean  @default(false) @map("grace_enabled")
  graceDays            Int      @default(0) @map("grace_days")
  freezeEnabled        Boolean  @default(false) @map("freeze_enabled")
  maxFreezeDays        Int      @default(0) @map("max_freeze_days")
  maxFreezeDaysPerYear Int      @default(0) @map("max_freeze_days_per_year")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("tenant_settings")
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  staff        Staff[]
  members      Member[]
  planBranches PlanBranch[]
  checkIns     CheckIn[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("branches")
}

/// Gym staff. Email is unique per tenant (login also needs the tenant slug).
model Staff {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId       String?   @map("branch_id") @db.Uuid
  branch         Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name           String
  email          String
  password       String
  role           StaffRole
  sessionVersion Int       @default(0) @map("session_version")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  checkIns       CheckIn[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("staff")
}

enum MemberStatus {
  ACTIVE
  ARCHIVED
}

/// Gym member. No login in v1. Phone is unique per tenant (E.164).
model Member {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  homeBranchId String       @map("home_branch_id") @db.Uuid
  homeBranch   Branch       @relation(fields: [homeBranchId], references: [id], onDelete: Restrict)
  name         String
  phone        String
  email        String?
  notes        String?
  status       MemberStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  subscriptions Subscription[]
  notifications Notification[]
  checkIns      CheckIn[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([homeBranchId])
  @@map("members")
}

enum PlanStatus {
  ACTIVE
  ARCHIVED
}

/// What the gym sells. durationDays is always required.
/// sessionCount is optional (unlimited visits until the days end, still capped per day).
/// maxVisitsPerDay is how many check-ins are allowed on one calendar day (enforced at check-in).
/// allBranches true = every location; false = PlanBranch rows only.
model Plan {
  id              String     @id @default(uuid()) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  durationDays    Int        @map("duration_days")
  sessionCount    Int?       @map("session_count")
  maxVisitsPerDay Int        @default(1) @map("max_visits_per_day")
  /// Major units of the tenant currency (EGP for Egypt). Not Stripe.
  price           Decimal    @db.Decimal(12, 2)
  allBranches     Boolean    @default(true) @map("all_branches")
  status          PlanStatus @default(ACTIVE)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  branches      PlanBranch[]
  subscriptions Subscription[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("plans")
}

/// Selected locations when Plan.allBranches is false. tenant_id is for RLS.
model PlanBranch {
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId   String @map("plan_id") @db.Uuid
  plan     Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@id([planId, branchId])
  @@index([tenantId])
  @@index([branchId])
  @@map("plan_branches")
}

enum SubscriptionStatus {
  ACTIVE
  FROZEN
  IN_GRACE
  EXPIRED
  CANCELLED
}

/// A member's purchased plan. Terms are snapshotted at join time.
/// EXPIRED at endsAt. IN_GRACE only after a check-in during the extra days.
model Subscription {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId          String             @map("member_id") @db.Uuid
  member            Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  planId            String             @map("plan_id") @db.Uuid
  plan              Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  planName          String             @map("plan_name")
  durationDays      Int                @map("duration_days")
  sessionCount      Int?               @map("session_count")
  sessionsRemaining Int?               @map("sessions_remaining")
  maxVisitsPerDay   Int                @map("max_visits_per_day")
  price             Decimal            @db.Decimal(12, 2)
  allBranches       Boolean            @map("all_branches")
  startsAt          DateTime           @map("starts_at")
  endsAt            DateTime           @map("ends_at")
  frozenAt          DateTime?          @map("frozen_at")
  freezeEndsAt      DateTime?          @map("freeze_ends_at")
  expiredAt         DateTime?          @map("expired_at")
  /// Set on the first grace check-in. This sold plan never gets a second window.
  graceUsedAt       DateTime?          @map("grace_used_at")
  /// accessUntil at the moment grace was used. Later settings changes do not move it.
  graceEndsAt       DateTime?          @map("grace_ends_at")
  status            SubscriptionStatus @default(ACTIVE)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  freezes       SubscriptionFreeze[]
  notifications Notification[]
  checkIns      CheckIn[]

  @@index([tenantId])
  @@index([memberId])
  @@index([planId])
  @@map("subscriptions")
}

/// One freeze episode. days is what staff requested. unfrozenAt is null while open.
model SubscriptionFreeze {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptionId String       @map("subscription_id") @db.Uuid
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  days           Int
  startedAt      DateTime     @map("started_at")
  endedAt        DateTime     @map("ended_at")
  unfrozenAt     DateTime?    @map("unfrozen_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([subscriptionId])
  @@map("subscription_freezes")
}

enum NotificationType {
  SUBSCRIPTION_IN_GRACE
  SUBSCRIPTION_EXPIRED
}

/// Gym inbox row. One per (type, subscription) so settle/sweep never spam.
/// IN_GRACE is written at check-in (Phase 9), not when the calendar enters grace.
/// readAt is shared: the desk is one team, not a per-person bell.
model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type           NotificationType
  subscriptionId String           @map("subscription_id") @db.Uuid
  subscription   Subscription     @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  memberId       String           @map("member_id") @db.Uuid
  member         Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberName     String           @map("member_name")
  planName       String           @map("plan_name")
  readAt         DateTime?        @map("read_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  @@unique([tenantId, type, subscriptionId])
  @@index([tenantId])
  @@index([memberId])
  @@index([subscriptionId])
  @@map("notifications")
}

/// One door visit. tenant_id is for RLS.
model CheckIn {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId       String       @map("member_id") @db.Uuid
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  subscriptionId String       @map("subscription_id") @db.Uuid
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  branchId       String       @map("branch_id") @db.Uuid
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  staffId        String       @map("staff_id") @db.Uuid
  staff          Staff        @relation(fields: [staffId], references: [id], onDelete: Restrict)
  checkedInAt    DateTime     @default(now()) @map("checked_in_at")

  @@index([tenantId])
  @@index([memberId])
  @@index([subscriptionId, checkedInAt])
  @@index([branchId])
  @@map("check_ins")
}
